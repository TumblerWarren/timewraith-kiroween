+// @ts-nocheck
+const m = require('../time');
+
+function nextMs(cron, startMs, zone) {
+  const ct = new m.CronTime(cron);
+  return ct.getNextDateFrom(new Date(startMs), zone).toMillis();
+}
+
+async function run(ctx) {
+  const zone = 'Australia/Lord_Howe';
+  const cron = '0 */15 * * * *';
+  const call = (startMs) => nextMs(cron, startMs, zone);
+  const nowMs = ctx.now.getTime();
+  const next = call(nowMs);
+  const next_early = await ctx.atClock(-30 * 86400000, () => call(nowMs));
+
+  const lhSpring = Date.UTC(2027, 9, 2, 15, 30, 0); // 2027-10-03 02:00+10:30 -> 02:30+11:00
+  const lhFall = Date.UTC(2027, 3, 3, 15, 0, 0);
+  const chSpring = Date.UTC(2027, 8, 25, 14, 0, 0); // 2027-09-26 02:45+12:45 -> 03:45+13:45
+
+  const calendar_cases = [
+    {
+      name: 'lord-howe-gap-daily-0215-before',
+      actual: nextMs('0 15 2 * * *', lhSpring - 1, 'Australia/Lord_Howe'),
+      expected: lhSpring
+    },
+    {
+      name: 'lord-howe-gap-quarter-before',
+      actual: nextMs('0 */15 * * * *', lhSpring - 1, 'Australia/Lord_Howe'),
+      expected: lhSpring
+    },
+    {
+      name: 'lord-howe-daily-0215-at-shift',
+      actual: nextMs('0 15 2 * * *', lhSpring, 'Australia/Lord_Howe'),
+      // 2027-10-04 02:15+11:00
+      expected: Date.UTC(2027, 9, 3, 15, 15, 0)
+    },
+    {
+      name: 'lord-howe-overlap-fires-once',
+      actual: nextMs('0 45 1 * * *', Date.UTC(2027, 3, 3, 14, 45, 0), 'Australia/Lord_Howe'),
+      // 2027-04-05 01:45+10:30, skipping the repeated 01:45 on Apr 4
+      expected: Date.UTC(2027, 3, 4, 15, 15, 0)
+    },
+    {
+      name: 'lord-howe-overlap-first-fire',
+      actual: nextMs('0 45 1 * * *', Date.UTC(2027, 3, 3, 14, 0, 0), 'Australia/Lord_Howe'),
+      // first 01:45 on Apr 4 at +11:00
+      expected: Date.UTC(2027, 3, 3, 14, 45, 0)
+    },
+    {
+      name: 'chatham-gap-daily-0315-before',
+      actual: nextMs('0 15 3 * * *', chSpring - 1, 'Pacific/Chatham'),
+      expected: chSpring
+    },
+    {
+      name: 'chatham-gap-daily-0315-at-shift',
+      actual: nextMs('0 15 3 * * *', chSpring, 'Pacific/Chatham'),
+      // 2027-09-27 03:15+13:45
+      expected: Date.UTC(2027, 8, 26, 13, 30, 0)
+    },
+    {
+      name: 'eucla-control-daily-0215',
+      actual: nextMs('0 15 2 * * *', Date.UTC(2027, 9, 2, 15, 0, 0), 'Australia/Eucla'),
+      // 2027-10-03 02:15+08:45
+      expected: Date.UTC(2027, 9, 2, 17, 30, 0)
+    }
+  ];
+
+  return { next, next_early, calendar_cases };
+}
+
+module.exports = { run };
