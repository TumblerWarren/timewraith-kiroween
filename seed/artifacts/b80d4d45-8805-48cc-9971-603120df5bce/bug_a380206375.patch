+// @ts-nocheck
+const m = require('../parseoptions')
+
+function summarize(po) {
+  const o = po.parsedOptions
+  return {
+    dtstart: o.dtstart instanceof Date ? o.dtstart.getTime() : o.dtstart,
+    until: o.until instanceof Date ? o.until.getTime() : (o.until === undefined ? null : o.until),
+    bymonth: o.bymonth === undefined ? null : o.bymonth,
+    bymonthday: o.bymonthday,
+    byweekday: o.byweekday === undefined ? null : o.byweekday,
+    byhour: o.byhour,
+    byminute: o.byminute,
+    bysecond: o.bysecond,
+  }
+}
+
+function run(ctx) {
+  const U = Date.UTC
+  const cases = [
+    { tzid: 'America/New_York', dtstart: new Date(U(2024, 2, 10, 2, 30, 0)), until: new Date(U(2024, 2, 10, 7, 30, 0)) },
+    { tzid: 'America/New_York', dtstart: new Date(U(2024, 10, 3, 1, 30, 0)), until: new Date(U(2024, 10, 3, 6, 30, 0)) },
+    { tzid: 'Australia/Lord_Howe', dtstart: new Date(U(2024, 9, 6, 2, 15, 0)), until: new Date(U(2024, 3, 7, 1, 45, 0)) },
+    { tzid: 'Asia/Kathmandu', dtstart: new Date(U(2024, 0, 31, 23, 59, 59)) },
+    { tzid: 'America/New_York', dtstart: new Date(U(2024, 0, 31, 23, 59, 59)) },
+    { tzid: 'Australia/Lord_Howe', dtstart: new Date(U(2024, 1, 29, 0, 0, 0)) },
+    { tzid: 'Asia/Kathmandu', dtstart: new Date(U(2024, 1, 29, 23, 59, 59)) },
+    { tzid: 'America/New_York', dtstart: new Date(U(2023, 0, 31, 0, 0, 0)) },
+  ]
+  const freqs = [0, 1, 2, 3]
+  const results = []
+  for (const c of cases) {
+    for (const freq of freqs) {
+      const opts = { freq: freq, tzid: c.tzid, dtstart: c.dtstart }
+      if (c.until) opts.until = c.until
+      results.push(summarize(m.parseOptions(opts)))
+    }
+  }
+  // Default dtstart taken from the current time
+  const defaults = []
+  for (const freq of [0, 1, 2, 3, 4, 5, 6]) {
+    defaults.push(summarize(m.parseOptions({ freq: freq, tzid: 'America/New_York' })))
+  }
+  const dflt = m.parseOptions({ freq: 3 }).parsedOptions.dtstart
+  return { instant: dflt, value: { results: results, defaults: defaults } }
+}
+
+module.exports = { run }
