{
  "version": "v1",
  "hooks": [
    {
      "name": "Lint and typecheck on save",
      "description": "ESLint the saved file, then tsc --noEmit. Skips until frontend/ exists.",
      "trigger": "PostFileSave",
      "matcher": "frontend[\\\\/]src[\\\\/].*\\.(ts|tsx)$",
      "action": {
        "type": "command",
        "command": "node scripts/hooks/web-check.mjs"
      },
      "timeout": 120,
      "enabled": false
    }
  ]
}