# Copy to .env next to compose.yaml. Every setting is optional.

# Port on localhost. The API has no login, so the compose file never exposes it beyond 127.0.0.1.
# TW_PORT=8787

# Linux only: the group that owns /var/run/docker.sock, so the backend can start the test containers.
#   DOCKER_GID=$(stat -c %g /var/run/docker.sock)
# DOCKER_GID=0

# Active seconds per investigation (default 10800, three hours).
# TW_INVESTIGATION_BUDGET_S=10800

# auto: the Kiro Crew once it is signed in, otherwise the stub that reports "not run". stub: never an agent.
# TW_AGENT_RUNTIME=auto

# To run a second copy next to the first, give it its own names and port.
# TW_PROJECT=timewraith
# TW_DATA_VOLUME=timewraith-data
# TW_CREW_CONTAINER=timewraith-crew
# TW_CREW_VOLUME=timewraith-crew-home
# TW_GIT_CONTAINER=timewraith-git
# TW_GIT_VOLUME=timewraith-git-home
# TW_NETWORK=timewraith-net
