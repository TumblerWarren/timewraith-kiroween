{
  "name": "timewraith-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.13.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build --configLoader runner",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest --configLoader runner",
    "test:run": "vitest run --configLoader runner",
    "guard:style": "node ../scripts/check-style-guard.mjs --all",
    "verify": "pnpm typecheck && pnpm lint && pnpm guard:style && pnpm test:run && pnpm build",
    "shots": "pnpm build && node scripts/shots.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.14",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "gsap": "^3.15.1",
    "motion": "^14.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
