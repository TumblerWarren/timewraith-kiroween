# Copy to backend/.env (git-ignored). Every setting is optional; uncomment a line only to change its default.

# Data folder for the SQLite file, workspaces and patches. Default: .timewraith in your home folder.
# It must be outside this repository.
# TW_DATA_DIR=

# auto (default): the local Kiro Crew container once it is signed in, otherwise the stub.
# stub: never an LLM. command: run TW_AGENT_COMMAND per agent call.
# TW_AGENT_RUNTIME=auto
# TW_AGENT_COMMAND=

# Read-only GitHub token; raises the issue-search rate limit. Never commit a real token.
# TW_GITHUB_TOKEN=

# Frontend origins allowed to call the API directly (the Vite proxy does not need this).
# TW_CORS_ORIGINS=["http://localhost:5173"]
