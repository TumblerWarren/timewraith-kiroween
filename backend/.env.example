# Copy to backend/.env (git-ignored). All settings are optional.
# Data folder for the SQLite file, workspaces and artifacts. Must be outside this repository.
TW_DATA_DIR=C:/Users/you/.timewraith
# stub | command   (command needs Kiro Crew / kiro-cli installed; backend spec task 1.1)
TW_AGENT_RUNTIME=stub
# Headless agent call. {agent} becomes the agent name; the prompt is sent on stdin; one JSON object expected on stdout.
TW_AGENT_COMMAND=
# Read-only GitHub token (raises the issue-search rate limit). Never commit a real token.
TW_GITHUB_TOKEN=
TW_CORS_ORIGINS=["http://localhost:5173"]
