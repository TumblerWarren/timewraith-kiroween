      "title": "Kind",
      "type": "string"
    },
    "node_version": {
      "default": "22",
      "title": "Node Version",
      "type": "string"
    },
    "package_manager": {
      "anyOf": [
        {
          "enum": [
            "npm",
            "pnpm",
            "yarn"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Package Manager"
    },
    "scripts": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "title": "Scripts",
      "type": "object"
    },
    "test_runner": {
      "anyOf": [
        {
          "enum": [
            "vitest",
            "jest"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Test Runner"
    }
  },
  "title": "CapabilityReport",
  "type": "object"
}
