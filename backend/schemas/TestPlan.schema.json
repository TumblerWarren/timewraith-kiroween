{
  "$defs": {
    "Experiment": {
      "properties": {
        "adapter": {
          "default": "js_sweep",
          "enum": [
            "js_sweep",
            "python_pytest",
            "python_crew"
          ],
          "title": "Adapter",
          "type": "string"
        },
        "adapter_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Code"
        },
        "adapter_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Path"
        },
        "anchors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Anchors",
          "type": "array"
        },
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "categories": {
          "items": {
            "enum": [
              "timezone_conversion",
              "midnight_rollover",
              "dst_transition",
              "expiry_boundary",
              "other_temporal"
            ],
            "type": "string"
          },
          "title": "Categories",
          "type": "array"
        },
        "claim": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim"
        },
        "executability": {
          "enum": [
            "ready",
            "needs_setup",
            "not_controllable"
          ],
          "title": "Executability",
          "type": "string"
        },
        "executability_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executability Reason"
        },
        "failure_kind": {
          "anyOf": [
            {
              "enum": [
                "adapter",
                "environment",
                "throttled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Kind"
        },
        "fields": {
          "default": [],
          "items": {
            "enum": [
              "instant",
              "next",
              "flag",
              "date",
              "value",
              "after_cancel",
              "timeout_trace",
              "interval_trace",
              "expiry_trace",
              "clock_jumps",
              "calendar_cases"
            ],
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "harness_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Harness Path"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "invariants": {
          "default": [],
          "items": {
            "$ref": "#/$defs/InvariantUse"
          },
          "title": "Invariants",
          "type": "array"
        },
        "point_count": {
          "default": 0,
          "title": "Point Count",
          "type": "integer"
        },
        "runner_config": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runner Config"
        },
        "status": {
          "default": "planned",
          "enum": [
            "planned",
            "designed",
            "not_designed",
            "adapter_invalid",
            "not_run",
            "swept"
          ],
          "title": "Status",
          "type": "string"
        },
        "zones": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Zones",
          "type": "array"
        }
      },
      "required": [
        "id",
        "candidate_id",
        "categories",
        "executability"
      ],
      "title": "Experiment",
      "type": "object"
    },
    "InvariantUse": {
      "properties": {
        "expectation_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Repository test or doc passage supporting this rule",
          "title": "Expectation Ref"
        },
        "expired_at_deadline": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Explicit cited expiry policy at equality",
          "title": "Expired At Deadline"
        },
        "id": {
          "enum": [
            "well_formed",
            "deterministic",
            "local_date_matches",
            "instant_zone_independent",
            "flag_monotonic",
            "next_after_now",
            "retry_cancelled",
            "timeout_delivery",
            "interval_delivery",
            "expiry_deadline",
            "elapsed_clock_jump",
            "python_assertion",
            "calendar_contract"
          ],
          "title": "Id",
          "type": "string"
        },
        "max_gap_ms": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Gap Ms"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "reason"
      ],
      "title": "InvariantUse",
      "type": "object"
    }
  },
  "properties": {
    "capped": {
      "default": false,
      "title": "Capped",
      "type": "boolean"
    },
    "experiments": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Experiment"
      },
      "title": "Experiments",
      "type": "array"
    },
    "kind": {
      "const": "Planned experiments, not run",
      "default": "Planned experiments, not run",
      "title": "Kind",
      "type": "string"
    }
  },
  "title": "TestPlan",
  "type": "object"
}
