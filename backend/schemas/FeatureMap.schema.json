{
  "$defs": {
    "Candidate": {
      "properties": {
        "bug_categories": {
          "items": {
            "enum": [
              "timezone_conversion",
              "midnight_rollover",
              "dst_transition",
              "expiry_boundary",
              "other_temporal"
            ],
            "type": "string"
          },
          "title": "Bug Categories",
          "type": "array"
        },
        "existing_tests": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Existing Tests",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "score_parts": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Score Parts",
          "type": "object"
        },
        "selected": {
          "default": false,
          "title": "Selected",
          "type": "boolean"
        },
        "signal_ids": {
          "items": {
            "type": "string"
          },
          "title": "Signal Ids",
          "type": "array"
        },
        "status": {
          "const": "candidate",
          "default": "candidate",
          "title": "Status",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/CodeUnit"
        }
      },
      "required": [
        "id",
        "title",
        "unit",
        "signal_ids",
        "bug_categories",
        "score",
        "score_parts"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "CodeUnit": {
      "properties": {
        "end_line": {
          "title": "End Line",
          "type": "integer"
        },
        "exported": {
          "title": "Exported",
          "type": "boolean"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "start_line": {
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "name",
        "start_line",
        "end_line",
        "exported"
      ],
      "title": "CodeUnit",
      "type": "object"
    },
    "Signal": {
      "properties": {
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "excerpt": {
          "title": "Excerpt",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "in_test": {
          "default": false,
          "title": "In Test",
          "type": "boolean"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "line": {
          "title": "Line",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "path",
        "line",
        "confidence",
        "excerpt"
      ],
      "title": "Signal",
      "type": "object"
    }
  },
  "properties": {
    "candidates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "kind": {
      "const": "Discovery candidates, not verified bugs",
      "default": "Discovery candidates, not verified bugs",
      "title": "Kind",
      "type": "string"
    },
    "note": {
      "const": "These are candidates, not proven bugs.",
      "default": "These are candidates, not proven bugs.",
      "title": "Note",
      "type": "string"
    },
    "signals": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Signal"
      },
      "title": "Signals",
      "type": "array"
    },
    "skipped": {
      "additionalProperties": {
        "type": "integer"
      },
      "default": {},
      "title": "Skipped",
      "type": "object"
    }
  },
  "title": "FeatureMap",
  "type": "object"
}
