{
  "$defs": {
    "Budget": {
      "properties": {
        "active_seconds": {
          "default": 0.0,
          "title": "Active Seconds",
          "type": "number"
        },
        "agent_calls": {
          "default": 0,
          "title": "Agent Calls",
          "type": "integer"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "Bug": {
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "timezone_conversion",
            "midnight_rollover",
            "dst_transition",
            "expiry_boundary",
            "other_temporal"
          ],
          "title": "Category",
          "type": "string"
        },
        "clock": {
          "$ref": "#/$defs/ClockConfig"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "experiment_id": {
          "title": "Experiment Id",
          "type": "string"
        },
        "failure": {
          "title": "Failure",
          "type": "string"
        },
        "fix": {
          "$ref": "#/$defs/Fix",
          "default": {
            "attempts": [],
            "branch": null,
            "label": "Fix not started",
            "publish": null,
            "state": "not-started",
            "user_decision": "pending"
          }
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "invariant": {
          "enum": [
            "well_formed",
            "deterministic",
            "local_date_matches",
            "instant_zone_independent",
            "flag_monotonic",
            "next_after_now"
          ],
          "title": "Invariant",
          "type": "string"
        },
        "issue_match": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issue Match"
        },
        "issue_match_label": {
          "default": "No matching public issue found",
          "title": "Issue Match Label",
          "type": "string"
        },
        "regression_test": {
          "title": "Regression Test",
          "type": "string"
        },
        "regression_test_path": {
          "title": "Regression Test Path",
          "type": "string"
        },
        "reproduction": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reproduction"
        },
        "retests": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Retest"
          },
          "title": "Retests",
          "type": "array"
        },
        "status": {
          "enum": [
            "planned",
            "observed-anomaly",
            "reproduced",
            "known-issue-match",
            "fixed-version-verified",
            "inconclusive"
          ],
          "title": "Status",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "violation": {
          "$ref": "#/$defs/Violation"
        }
      },
      "required": [
        "id",
        "candidate_id",
        "experiment_id",
        "title",
        "category",
        "invariant",
        "status",
        "clock",
        "violation",
        "failure",
        "regression_test_path",
        "regression_test"
      ],
      "title": "Bug",
      "type": "object"
    },
    "Candidate": {
      "properties": {
        "bug_categories": {
          "items": {
            "enum": [
              "timezone_conversion",
              "midnight_rollover",
              "dst_transition",
              "expiry_boundary",
              "other_temporal"
            ],
            "type": "string"
          },
          "title": "Bug Categories",
          "type": "array"
        },
        "existing_tests": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Existing Tests",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "score_parts": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Score Parts",
          "type": "object"
        },
        "selected": {
          "default": false,
          "title": "Selected",
          "type": "boolean"
        },
        "signal_ids": {
          "items": {
            "type": "string"
          },
          "title": "Signal Ids",
          "type": "array"
        },
        "status": {
          "const": "candidate",
          "default": "candidate",
          "title": "Status",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/CodeUnit"
        }
      },
      "required": [
        "id",
        "title",
        "unit",
        "signal_ids",
        "bug_categories",
        "score",
        "score_parts"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "CapabilityItem": {
      "properties": {
        "files": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Files",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "enum": [
            "supported",
            "unsupported",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "status",
        "reason"
      ],
      "title": "CapabilityItem",
      "type": "object"
    },
    "CapabilityReport": {
      "properties": {
        "items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CapabilityItem"
          },
          "title": "Items",
          "type": "array"
        },
        "kind": {
          "const": "Capability report",
          "default": "Capability report",
          "title": "Kind",
          "type": "string"
        },
        "node_version": {
          "default": "22",
          "title": "Node Version",
          "type": "string"
        },
        "package_manager": {
          "anyOf": [
            {
              "enum": [
                "npm",
                "pnpm",
                "yarn"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Manager"
        },
        "scripts": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Scripts",
          "type": "object"
        },
        "test_runner": {
          "anyOf": [
            {
              "enum": [
                "vitest",
                "jest"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test Runner"
        }
      },
      "title": "CapabilityReport",
      "type": "object"
    },
    "CheckResult": {
      "description": "One of the repository's own checks (its tests, lint, format) run on the contribution in the sandbox.",
      "properties": {
        "command": {
          "title": "Command",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "preexisting": {
          "default": false,
          "title": "Preexisting",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "command",
        "passed"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "ClockConfig": {
      "properties": {
        "instant": {
          "title": "Instant",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "scope": {
          "const": "test_process",
          "default": "test_process",
          "title": "Scope",
          "type": "string"
        },
        "time_zone": {
          "title": "Time Zone",
          "type": "string"
        }
      },
      "required": [
        "instant",
        "time_zone",
        "label"
      ],
      "title": "ClockConfig",
      "type": "object"
    },
    "CodeUnit": {
      "properties": {
        "end_line": {
          "title": "End Line",
          "type": "integer"
        },
        "exported": {
          "title": "Exported",
          "type": "boolean"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "start_line": {
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "name",
        "start_line",
        "end_line",
        "exported"
      ],
      "title": "CodeUnit",
      "type": "object"
    },
    "Contribution": {
      "description": "The fix shaped to the repository's rules: rebased, placed, formatted, checked, with its PR text.",
      "properties": {
        "base": {
          "title": "Base",
          "type": "string"
        },
        "body": {
          "title": "Body",
          "type": "string"
        },
        "checks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CheckResult"
          },
          "title": "Checks",
          "type": "array"
        },
        "notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "prepared_at": {
          "title": "Prepared At",
          "type": "string"
        },
        "rebased": {
          "title": "Rebased",
          "type": "boolean"
        },
        "rules": {
          "$ref": "#/$defs/RuleSummary"
        },
        "test_path": {
          "title": "Test Path",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "prepared_at",
        "rules",
        "base",
        "rebased",
        "title",
        "body",
        "test_path"
      ],
      "title": "Contribution",
      "type": "object"
    },
    "CoverageRow": {
      "description": "What the Crew tested for one candidate, computed by code from experiments, sweeps and verdicts.",
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "edges": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Edges",
          "type": "array"
        },
        "experiments": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Experiments",
          "type": "array"
        },
        "outcome": {
          "default": "",
          "title": "Outcome",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "rules": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Rules",
          "type": "array"
        },
        "status": {
          "enum": [
            "not_selected",
            "not_designed",
            "adapter_invalid",
            "clean",
            "violations"
          ],
          "title": "Status",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "unit",
        "path",
        "status"
      ],
      "title": "CoverageRow",
      "type": "object"
    },
    "CreateInvestigation": {
      "properties": {
        "area": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Area"
        },
        "auto": {
          "default": false,
          "title": "Auto",
          "type": "boolean"
        },
        "issue_url": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issue Url"
        },
        "mode": {
          "default": "open-hunt",
          "enum": [
            "known-issue",
            "blind-hunt",
            "open-hunt"
          ],
          "title": "Mode",
          "type": "string"
        },
        "ref": {
          "maxLength": 200,
          "title": "Ref",
          "type": "string"
        },
        "repository_url": {
          "maxLength": 300,
          "title": "Repository Url",
          "type": "string"
        }
      },
      "required": [
        "repository_url",
        "ref"
      ],
      "title": "CreateInvestigation",
      "type": "object"
    },
    "DecisionRecord": {
      "description": "Why the Crew did something: the agent's claim, its checked evidence, and the code rule that decided.",
      "properties": {
        "agent": {
          "enum": [
            "wraith-director",
            "watchtower-warden",
            "bat-scout",
            "pumpkin-mechanic",
            "spider-weaver",
            "raven-archivist",
            "two-faced-jack",
            "doctor-stitch"
          ],
          "title": "Agent",
          "type": "string"
        },
        "at": {
          "title": "At",
          "type": "string"
        },
        "checks": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Checks",
          "type": "array"
        },
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "decision": {
          "enum": [
            "accepted",
            "rejected",
            "not_run"
          ],
          "title": "Decision",
          "type": "string"
        },
        "dropped_evidence": {
          "default": 0,
          "title": "Dropped Evidence",
          "type": "integer"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "phase": {
          "enum": [
            "repository",
            "discovery",
            "design",
            "execution",
            "verification",
            "fix"
          ],
          "title": "Phase",
          "type": "string"
        },
        "rule": {
          "title": "Rule",
          "type": "string"
        },
        "runtime": {
          "title": "Runtime",
          "type": "string"
        },
        "step": {
          "title": "Step",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "id",
        "at",
        "phase",
        "agent",
        "step",
        "runtime",
        "subject",
        "claim",
        "decision",
        "rule"
      ],
      "title": "DecisionRecord",
      "type": "object"
    },
    "Evidence": {
      "description": "One piece of evidence an agent cites. Code resolves every ref before the claim counts.",
      "properties": {
        "kind": {
          "enum": [
            "signal",
            "source",
            "invariant",
            "point",
            "issue",
            "test",
            "doc"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "description": "signal id | path:line[-line] (source, test, doc) | invariant id | zone@ISO | issue no.",
          "maxLength": 200,
          "title": "Ref",
          "type": "string"
        },
        "why": {
          "maxLength": 300,
          "title": "Why",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref",
        "why"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Experiment": {
      "properties": {
        "adapter": {
          "const": "js_sweep",
          "default": "js_sweep",
          "title": "Adapter",
          "type": "string"
        },
        "adapter_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Code"
        },
        "adapter_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Path"
        },
        "anchors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Anchors",
          "type": "array"
        },
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "categories": {
          "items": {
            "enum": [
              "timezone_conversion",
              "midnight_rollover",
              "dst_transition",
              "expiry_boundary",
              "other_temporal"
            ],
            "type": "string"
          },
          "title": "Categories",
          "type": "array"
        },
        "claim": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim"
        },
        "executability": {
          "enum": [
            "ready",
            "needs_setup",
            "not_controllable"
          ],
          "title": "Executability",
          "type": "string"
        },
        "executability_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executability Reason"
        },
        "fields": {
          "default": [],
          "items": {
            "enum": [
              "instant",
              "next",
              "flag",
              "date",
              "value"
            ],
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "harness_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Harness Path"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "invariants": {
          "default": [],
          "items": {
            "$ref": "#/$defs/InvariantUse"
          },
          "title": "Invariants",
          "type": "array"
        },
        "point_count": {
          "default": 0,
          "title": "Point Count",
          "type": "integer"
        },
        "status": {
          "default": "planned",
          "enum": [
            "planned",
            "designed",
            "not_designed",
            "adapter_invalid",
            "swept"
          ],
          "title": "Status",
          "type": "string"
        },
        "zones": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Zones",
          "type": "array"
        }
      },
      "required": [
        "id",
        "candidate_id",
        "categories",
        "executability"
      ],
      "title": "Experiment",
      "type": "object"
    },
    "FeatureMap": {
      "properties": {
        "candidates": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Candidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "kind": {
          "const": "Discovery candidates, not verified bugs",
          "default": "Discovery candidates, not verified bugs",
          "title": "Kind",
          "type": "string"
        },
        "note": {
          "const": "These are candidates, not proven bugs.",
          "default": "These are candidates, not proven bugs.",
          "title": "Note",
          "type": "string"
        },
        "signals": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Signal"
          },
          "title": "Signals",
          "type": "array"
        },
        "skipped": {
          "additionalProperties": {
            "type": "integer"
          },
          "default": {},
          "title": "Skipped",
          "type": "object"
        }
      },
      "title": "FeatureMap",
      "type": "object"
    },
    "Fix": {
      "properties": {
        "attempts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FixAttempt"
          },
          "title": "Attempts",
          "type": "array"
        },
        "branch": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixBranch"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "label": {
          "default": "Fix not started",
          "title": "Label",
          "type": "string"
        },
        "publish": {
          "anyOf": [
            {
              "$ref": "#/$defs/Publish"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "state": {
          "default": "not-started",
          "enum": [
            "not-started",
            "in-progress",
            "verified",
            "no-safe-fix",
            "skipped"
          ],
          "title": "State",
          "type": "string"
        },
        "user_decision": {
          "default": "pending",
          "enum": [
            "pending",
            "accepted",
            "rejected"
          ],
          "title": "User Decision",
          "type": "string"
        }
      },
      "title": "Fix",
      "type": "object"
    },
    "FixAttempt": {
      "properties": {
        "accepted_by_gates": {
          "default": false,
          "title": "Accepted By Gates",
          "type": "boolean"
        },
        "attempt": {
          "title": "Attempt",
          "type": "integer"
        },
        "diff": {
          "title": "Diff",
          "type": "string"
        },
        "gates": {
          "default": [],
          "items": {
            "$ref": "#/$defs/GateResult"
          },
          "title": "Gates",
          "type": "array"
        },
        "root_cause": {
          "default": "",
          "title": "Root Cause",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "test_runs": {
          "default": 0,
          "title": "Test Runs",
          "type": "integer"
        },
        "tool_calls": {
          "default": 0,
          "title": "Tool Calls",
          "type": "integer"
        }
      },
      "required": [
        "attempt",
        "summary",
        "diff"
      ],
      "title": "FixAttempt",
      "type": "object"
